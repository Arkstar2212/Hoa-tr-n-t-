--- !u!114 &1998159670
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1998159668}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46eb1d00cd9c606489e60db7952253c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Gameplay.TreeClusterTestManager
  testCamera: {fileID: 1998159671}
  moveSpeed: 16
  smoothTime: 0.35
  options:
  - optionName: "Ph\u01B0\u01A1ng \xC1n 1"
    title: "R\u1EB7ng Tre & R\u1EEBng Tr\xE0m Th\u01B0a Tho\xE1ng (Airy Bamboo & Slender Melaleuca)"
    description: "\u2022 T\u1EC9 l\u1EC7: 40% tre nghi\xEAng, 35% tr\xE0m m\u1EA3nh, 25% chu\u1ED1i v\xE0 b\u1EE5i th\u1EA5p che g\u1ED1c.\n\u2022 \u0110\u1EB7c t\xEDnh: Nh\u1EB9 nh\xE0ng, s\xE1ng s\u1EE7a, gi\u1EEF kho\u1EA3ng h\u1EDF ~45% b\u1EA7u tr\u1EDDi, kh\xF4ng g\xE2y c\u1EA3m gi\xE1c ng\u1ED9t ng\u1EA1t."
    cameraX: -60
    cameraDistance: 17.5
    cameraHeight: 2.4
    clusterRoot: {fileID: 981101265}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 2"
    title: "R\u1EEBng D\u1EEBa N\u01B0\u1EDBc & C\u1ED5 Th\u1EE4 Xum Hu\xEA (Lush Coconut & Banyan Canopy)"
    description: "\u2022 T\u1EC9 l\u1EC7: C\u1ED5 th\u1EE5 \u0111\u1EA1i ng\xE0n (trung t\xE2m) + D\u1EEBa Nam B\u1ED9 2 c\xE1nh + B\u1EE5i chu\u1ED1i b\u1EDD k\xEAnh.\n\u2022 \u0110\u1EB7c t\xEDnh: \u0110\u1ED9 ph\u1EE7 b\xF3ng cao (~80%), t\xE1n l\xE1 t\u1EA7ng t\u1EA7ng l\u1EDBp l\u1EDBp, \u1EA5m no tr\xF9 ph\xFA ven s\xF4ng r\u1EA1ch."
    cameraX: -30
    cameraDistance: 18
    cameraHeight: 2.5
    clusterRoot: {fileID: 1757017434}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 3"
    title: "R\u1EEBng U Minh S\xE2u 3 T\u1EA7ng L\u1EDBp (Layered Parallax Bands)"
    description: "\u2022 T\u1EC9 l\u1EC7: C\u1EADn h\u1EADu (4m) - Trung h\u1EADu (12m) - Vi\u1EC5n h\u1EADu m\u1EDD s\u01B0\u01A1ng (24m).\n\u2022 \u0110\u1EB7c t\xEDnh: Khai th\xE1c t\u1ED1i \u0111a hi\u1EC7u \u1EE9ng th\u1ECB sai (Parallax depth) khi camera cu\u1ED9n 2.5D."
    cameraX: 0
    cameraDistance: 19
    cameraHeight: 2.6
    clusterRoot: {fileID: 1671372826}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 4"
    title: "Lu\u1EF9 Tre & C\xE2y Nghi\xEAng Gi\xF3 \u0110\u1ED3ng (Windswept Bamboo & Trees)"
    description: "\u2022 T\u1EC9 l\u1EC7: C\xE2y cong v\u01B0\u01A1n m\xECnh + Lu\u1EF9 tre nghi\xEAng 8 \u0111\u1ED9 + Tr\xE0m m\u1EA3nh kh\u1EA3nh \u0111ung \u0111\u01B0a.\n\u2022 \u0110\u1EB7c t\xEDnh: \u0110\u1ED9ng l\u1EF1c h\u1ECDc th\u1ECB gi\xE1c (Visual Flow) d\u1EABn d\u1EAFt h\u01B0\u1EDBng di chuy\u1EC3n t\u1EEB tr\xE1i sang ph\u1EA3i."
    cameraX: 30
    cameraDistance: 17.5
    cameraHeight: 2.4
    clusterRoot: {fileID: 924460298}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 5"
    title: "V\u01B0\u1EDDn C\xE2y B\u1EDD K\xEAnh \u0110a D\u1EA1ng (Canal Embankment Mixed Orchard)"
    description: "\u2022 T\u1EC9 l\u1EC7: D\u1EEBa cao t\u1EA7ng 1 + C\xE2y \u0103n tr\xE1i t\u1EA7ng 2 + R\u1EB7ng chu\u1ED1i & b\u1EE5i th\u1EA5p t\u1EA7ng 3.\n\u2022 \u0110\u1EB7c t\xEDnh: B\u1ED1 c\u1EE5c t\u1EF1 nhi\xEAn so le kh\xF4ng \u0111\u1ED1i x\u1EE9ng, r\u1EA5t ph\xF9 h\u1EE3p h\u1EADu c\u1EA3nh ven nh\xE0 l\xE1 / b\u1EDD r\u1EA1ch."
    cameraX: 60
    cameraDistance: 18
    cameraHeight: 2.5
    clusterRoot: {fileID: 1028520863}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 6"
    title: "C\xE2y \u0110\u1EA1i Th\u1EE5 Landmark \u0110i\u1EC3m Nh\u1EA5n (Hero Banyan & Satellite Foliage)"
    description: "\u2022 T\u1EC9 l\u1EC7: 1 C\u1ED5 th\u1EE5 \u0111\u1EA1i ng\xE0n ph\xE2n t\u1EA7ng (14m t\xE1n) + 2 b\u1EE5i nh\u1ECF v\u1EC7 tinh hai b\xEAn.\n\u2022 \u0110\u1EB7c t\xEDnh: \u0110i\u1EC3m nh\u1EA5n th\u1ECB gi\xE1c m\u1EA1nh m\u1EBD (Focal Point), d\xE0nh ri\xEAng cho c\xE1c ph\xE2n \u0111o\u1EA1n t\u1EF1 s\u1EF1 / ho\xE0ng h\xF4n."
    cameraX: 90
    cameraDistance: 21
    cameraHeight: 3.2
    clusterRoot: {fileID: 1431030983}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 7"
    title: "R\u1EEBng Tr\xE0m B\u1EA1t Ng\xE0n M\xF9a N\u01B0\u1EDBc N\u1ED5i (Endless Melaleuca Vertical Rhythm)"
    description: "\u2022 T\u1EC9 l\u1EC7: 70% Tr\xE0m th\xE2n th\u1EB3ng \u0111a t\u1EA7ng (Z=6..18m) + 30% B\u1EE5i th\u1EA5p che ch\xE2n \u0111\u1EA5t ph\xE8n.\n\u2022 \u0110\u1EB7c t\xEDnh: Nh\u1ECBp \u0111i\u1EC7u s\u1ECDc d\u1ECDc (Vertical Rhythm) m\u1EA1nh m\u1EBD, t\xE1i hi\u1EC7n r\u1EEBng tr\xE0m U Minh m\xF9a n\u01B0\u1EDBc n\u1ED5i b\u1EA1t ng\xE0n."
    cameraX: 120
    cameraDistance: 18.5
    cameraHeight: 2.6
    clusterRoot: {fileID: 1375787553}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 8"
    title: "C\u1ED3n D\u1EEBa N\u01B0\u1EDBc B\u1EDD S\xF4ng \u0110\u1ED1c (S\xF4ng \u0110\u1ED1c Riverbank Coconut & Banana Fronds)"
    description: "\u2022 T\u1EC9 l\u1EC7: 50% D\u1EEBa Nam B\u1ED9 x\xF2e t\xE1n \u0111\xF3n gi\xF3 + 35% B\u1EE5i chu\u1ED1i m\u1ECDc ken d\xE0y + 15% C\xE2y \u0103n tr\xE1i b\u1EDD k\xEAnh.\n\u2022 \u0110\u1EB7c t\xEDnh: \u0110\u1EADm ch\u1EA5t c\u1ED3n b\xE3i s\xF4ng n\u01B0\u1EDBc mi\u1EC1n T\xE2y, t\xE1n d\u1EEBa cong duy\xEAn d\xE1ng t\u1EA1o n\xE9t sinh \u0111\u1ED9ng cho ch\xE2n tr\u1EDDi."
    cameraX: 150
    cameraDistance: 18
    cameraHeight: 2.5
    clusterRoot: {fileID: 1215841464}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 9"
    title: "C\u1ED5ng L\xE0ng V\xF2m Tre R\xE2m M\xE1t (Natural Bamboo Tunnel Arch)"
    description: "\u2022 T\u1EC9 l\u1EC7: 65% Tre l\xE0ng u\u1ED1n cong giao nhau + 20% C\xE2y \u0103n tr\xE1i xa + 15% B\u1EE5i c\u1ECF ven \u0111\u01B0\u1EDDng.\n\u2022 \u0110\u1EB7c t\xEDnh: T\u1EA1o c\u1EA3m gi\xE1c \u0111\u01B0\u1EDDng h\u1EA7m thi\xEAn nhi\xEAn (Green Tunnel), \u0111\xF3ng khung nh\xE2n v\u1EADt c\u1EF1c k\u1EF3 \u1EA5n t\u01B0\u1EE3ng."
    cameraX: 180
    cameraDistance: 18
    cameraHeight: 2.5
    clusterRoot: {fileID: 1920156578}
  - optionName: "Ph\u01B0\u01A1ng \xC1n 10"
    title: "R\u1EEBng Th\u01B0a Ho\xE0ng H\xF4n Ch\xE2n Tr\u1EDDi (Minimalist Vast Horizon & Story Beats)"
    description: "\u2022 T\u1EC9 l\u1EC7: C\xE2y th\u01B0a th\u1EDBt \u1EDF xa (Z=12..18m), ch\u1EEBa 65% di\u1EC7n t\xEDch cho n\u1EC1n tr\u1EDDi watercolor kho\xE1ng \u0111\u1EA1t.\n\u2022 \u0110\u1EB7c t\xEDnh: Tuy\u1EC7t v\u1EDDi cho c\xE1c tr\u01B0\u1EDDng \u0111o\u1EA1n ho\xE0ng h\xF4n, ho\xE0i ni\u1EC7m, \u0111\u1ED1i tho\u1EA1i n\u1ED9i t\xE2m ho\u1EB7c \u0111i\u1EC3m k\u1EBFt cutscene."
    cameraX: 210
    cameraDistance: 19.5
    cameraHeight: 2.8
    clusterRoot: {fileID: 550255641}
  - optionName: Demo Vista
    title: "To\xE0n C\u1EA3nh Ph\u1ED1i H\u1EE3p R\u1EEBng C\xE2y & \u0110\u1ED3ng L\xFAa (Full In-Context Vista Demo)"
    description: "\u2022 S\u1EF1 k\u1EBFt h\u1EE3p m\u1EABu gi\u1EEFa r\u1EEBng c\xE2y h\u1EADu c\u1EA3nh (Z=6..16m) v\u1EDBi d\u1EA3i l\xFAa v\xE0ng ti\u1EC1n c\u1EA3nh (Z=2..3.5m).\n\u2022 \u0110\xE1nh gi\xE1 tr\u1EF1c ti\u1EBFp c\u1EA3m gi\xE1c h\xF2a quy\u1EC7n, ph\xE2n t\u1EA7ng th\u1ECB sai v\xE0 chi\u1EC1u s\xE2u kh\xF4ng gian khi ch\u01A1i game."
    cameraX: 255
    cameraDistance: 21
    cameraHeight: 3
    clusterRoot: {fileID: 973941182}
  currentOptionIndex: 0

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d793b156dcfc0e4c9b378461b724b52, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Gameplay.IntroCutsceneController
  forcePlayIntro: 1
  autoFindReferencesOnStart: 1
  historySlides:
  - image: {fileID: 21300000, guid: b73bc08c4b38deb4fb9a493f46182a8e, type: 3}
    subtitle: "N\u0103m 1954 \u2014 Sau Hi\u1EC7p \u0111\u1ECBnh Gen\xE8ve, v\xF9ng \u0111\u1EA5t \u0110\u1ECF C\xE0 Mau tr\u1EDF th\xE0nh \u0111i\u1EC3m t\u1EADp k\u1EBFt 200 ng\xE0y l\u1ECBch s\u1EED."
    displayDuration: 5
  - image: {fileID: 21300000, guid: 0719188e6b227c3458491679901ff487, type: 3}
    subtitle: "H\xE0ng v\u1EA1n \u0111\u1ED3ng b\xE0o, chi\u1EBFn s\u0129 v\xE0 nh\u1EEFng ng\u01B0\u1EDDi con mi\u1EC1n Nam t\u1EC1 t\u1EF1u b\xEAn \u0111\xF4i b\u1EDD s\xF4ng \u0110\u1ED1c chu\u1EA9n b\u1ECB cho chuy\u1EBFn \u0111i xa."
    displayDuration: 5
  - image: {fileID: 21300000, guid: 6bcf1bc5577c38641a6cb82b98bdedeb, type: 3}
    subtitle: "Nh\u1EEFng \xE1nh m\u1EAFt l\u01B0u luy\u1EBFn, nh\u1EEFng c\xE1i \xF4m si\u1EBFt ch\u1EB7t v\xE0 l\u1EDDi th\u1EC1 son s\u1EAFt h\u1EB9n ng\xE0y non s\xF4ng th\u1ED1ng nh\u1EA5t."
    displayDuration: 5
  - image: {fileID: 21300000, guid: cc1f3247da81ae045879b0a85db8682b, type: 3}
    subtitle: "Chuy\u1EBFn t\xE0u chuy\u1EC3n qu\xE2n r\u1EDDi b\u1EBFn trong n\u1EAFng chi\u1EC1u, mang theo h\xE0nh trang c\u1EE7a c\u1EA3 m\u1ED9t th\u1EBF h\u1EC7 ki\xEAn trung."
    displayDuration: 5.5
  slideKenBurnsEndScale: 1.05
  slideCrossfadeDuration: 0.6
  shutterFlashDuration: 0.08
  filmJitterAmount: 2
  filmGrainPulseSpeed: 16
  projectorHumClip: {fileID: 0}
  slideAdvanceSfxClip: {fileID: 0}
  narrativeLines:
  - "N\u0103m 1954 \u2014 Sau Hi\u1EC7p \u0111\u1ECBnh Gen\xE8ve, v\xF9ng \u0111\u1EA5t \u0110\u1ECF C\xE0 Mau tr\u1EDF th\xE0nh \u0111i\u1EC3m h\u1EB9n c\u1EE7a l\u1ECBch s\u1EED."
  - "C\xF3 nh\u1EEFng cu\u1ED9c chia ly l\xE0 \u0111\u1EC3 h\u1EB9n ng\xE0y tr\u1EDF l\u1EA1i, c\xF3 nh\u1EEFng b\u01B0\u1EDBc ch\xE2n \u0111i l\xE0 v\xEC m\u1ED9t ng\xE0y mai \u0111\u1ED9c l\u1EADp."
  - "V\u1EDBi c\u1EADu b\xE9 An, ph\xEDa tr\u01B0\u1EDBc kh\xF4ng ch\u1EC9 l\xE0 m\u1ED9t chuy\u1EBFn h\xE0nh tr\xECnh..."
  - "...m\xE0 l\xE0 l\u1EDDi h\u1EE9a, l\xE0 s\u1EE9 m\u1EC7nh, v\xE0 l\xE0 ni\u1EC1m hy v\u1ECDng v\u1EC1 m\u1ED9t qu\xEA h\u01B0\u01A1ng tr\u1ECDn v\u1EB9n b\xECnh y\xEAn."
  monologueFadeInDuration: 1
  monologueHoldDuration: 3
  monologueFadeOutDuration: 0.8
  monologueAudioCrossfadeDuration: 3

  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "D\xEC Hai"
  npcTitle: "H\u1EADu ph\u01B0\u01A1ng ti\u1EC5n \u0111o\xE0n t\u1EADp k\u1EBFt"
  openingLines:
  - "B\xE0 con mang th\xEAm b\xE1nh t\xE9t, g\u1EA1o m\u1EDBi ra b\u1EBFn S\xF4ng \u0110\u1ED1c g\u1EEDi c\xE1c anh b\u1ED9 \u0111\u1ED9i nghen!"
  - "\u0110i m\u1EA1nh gi\u1ECFi, ng\xE0y th\u1ED1ng nh\u1EA5t h\xF2a b\xECnh l\u1EA1i v\u1EC1 v\u1EDBi qu\xEA h\u01B0\u01A1ng C\xE0 Mau!"
  choices:
  - choiceText: "D\xEC Hai \u01A1i, m\u1ECDi ng\u01B0\u1EDDi s\u1EBD s\u1EDBm tr\u1EDF v\u1EC1 sum h\u1ECDp ph\u1EA3i kh\xF4ng d\xEC?"
    responseLine: "Ch\u1EAFc ch\u1EAFn r\u1ED3i ch\xE1u! \u0110\u1ED3ng b\xE0o mi\u1EC1n Nam l\xFAc n\xE0o c\u0169ng h\u01B0\u1EDBng v\u1EC1 ng\xE0y h\u1ED9i ng\u1ED9."
    responseAnim: Female_Talking_02
  defaultAnimState: Female_Waving
  talkAnimState: Female_Talking_02
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

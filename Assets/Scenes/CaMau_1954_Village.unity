--- !u!114 &1349965511
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1349965509}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "Tr\u01B0\u1EDFng Th\xF4n N\u0103m"
  npcTitle: "B\u1EADc cao ni\xEAn x\xF3m R\u1EA1ch G\u1ED1c"
  openingLines:
  - "Ch\xE0o ch\xE1u An! L\xFAa n\u0103m nay tr\xFAng m\xF9a l\u1EDBn, h\u1EA1t n\xE0o h\u1EA1t n\u1EA5y m\u1EA9y v\xE0ng \xF3ng \u1EA3 kh\u1EAFp \u0111\u1ED3ng."
  - "X\xF3m m\xECnh \u0111ang ph\u01A1i l\xFAa m\u1EDBi \u0111\u1EC3 \u0111\xF3ng bao g\u1EEDi ra mi\u1EC1n B\u1EAFc theo \u0111o\xE0n t\xE0u t\u1EADp k\u1EBFt ngo\xE0i c\u1EEDa S\xF4ng \u0110\u1ED1c \u0111\xF3."
  choices:
  - choiceText: "Ch\xE1u th\u1EA5y \u0111\u1ED3ng l\xFAa v\xE0ng tr\u1EA3i d\xE0i \u0111\u1EB9p qu\xE1 th\u01B0a b\xE1c!"
    responseLine: "\u0110\xFAng r\u1ED3i ch\xE1u, \u0111\u1EA5t \u0111ai Nam B\u1ED9 ph\xF9 sa m\xE0u m\u1EE1 nu\xF4i n\u1EA5ng ng\u01B0\u1EDDi d\xE2n m\xECnh. Gi\u1EEF l\u1EA5y h\u1EA1t ng\u1ECDc tr\u1EDDi n\xE0y nghe con."
    responseAnim: OldMan_Talking
  - choiceText: "B\xE1c cho ch\xE1u h\u1ECFi t\xE0u t\u1EADp k\u1EBFt bao gi\u1EDD r\u1EDDi b\u1EBFn?"
    responseLine: "S\u1EAFp r\u1ED3i con \xE0. Ch\xFA B\u1EA3y ngo\xE0i b\u1EBFn \u0111\xF2 \u0111ang h\u1ED1i h\u1EA3 chuy\u1EC3n nh\u1EEFng bao g\u1EA1o cu\u1ED1i c\xF9ng l\xEAn ghe \u0111\u1EA5y."
    responseAnim: OldMan_Talking
  - choiceText: "Ch\xE1u xin ph\xE9p \u0111i d\u1EA1o ti\u1EBFp quanh x\xF3m \u1EA1."
    responseLine: "\u0110i c\u1EA9n th\u1EADn nghe con, nh\u1EDB gh\xE9 qua m\xE1 d\u1EB7n chuy\u1EC7n nh\xE0 tr\u01B0\u1EDBc khi tr\u1EDDi t\u1ED1i nghen."
    responseAnim: OldMan_Talking
  defaultAnimState: OldMan_Idle
  talkAnimState: OldMan_Talking
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

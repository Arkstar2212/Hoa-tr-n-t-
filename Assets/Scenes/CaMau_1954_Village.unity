  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "B\xE1c Ba Phi"
  npcTitle: "Huy\u1EC1n tho\u1EA1i k\u1EC3 chuy\u1EC7n r\u1EEBng U Minh"
  openingLines:
  - "Hahaha! Th\u1EB1ng nh\u1ECF An l\u1EA1i \u0111\xE2y b\xE1c Ba k\u1EC3 chuy\u1EC7n b\u1EAFt c\xE1 s\u1EA5u kh\u1ED5ng l\u1ED3 \u1EDF lung Tr\xE0m cho nghe!"
  - "B\u1EEFa \u0111\xF3 s\u1EA5u n\u1ED5i \u0111\u1EB7c nh\u01B0 b\xE8o, b\xE1c ch\u1EC9 c\u1EA7n qu\u0103ng m\u1ED9t s\u1EE3i d\xE2y m\xE2y l\xE0 l\xF4i th\u1EB3ng l\xEAn b\u1EDD m\u1ED9t con d\xE0i c\u1EA3 ch\u1EE5c th\u01B0\u1EDBc!"
  choices:
  - choiceText: "B\xE1c Ba k\u1EC3 thi\u1EC7t kh\xF4ng hay b\xE1c l\u1EA1i n\xF3i d\xF3c \u0111\xF3?"
    responseLine: "T\u1ED5 cha m\xE0y! B\xE1c Ba m\xE0y m\xE0 th\xE8m n\xF3i d\xF3c h\u1EA3! H\u1ECFi c\u1EA3 x\xF3m R\u1EA1ch G\u1ED1c n\xE0y ai m\xE0 kh\xF4ng ph\u1EE5c t\xE0i b\xE1c!"
    responseAnim: OldMan_Talking
  - choiceText: "Con th\xEDch nghe chuy\u1EC7n b\xE1c Ba c\u01B0\u1EE1i r\xF9a v\xE0ng h\u01A1n!"
    responseLine: "H\xE8 h\xE8, \u0111\u1EC3 b\u1EEFa n\xE0o r\u1EA3nh b\xE1c d\u1EABn m\xE0y v\xF4 lung Tr\xE0m, ch\u1EC9 cho con r\xF9a to b\u1EB1ng c\xE1i nia ph\u01A1i l\xFAa!"
    responseAnim: OldMan_Talking
  defaultAnimState: OldMan_Idle
  talkAnimState: OldMan_Talking
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

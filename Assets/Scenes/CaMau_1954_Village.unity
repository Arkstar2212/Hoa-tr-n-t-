  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "Ch\xFA S\xE1u L\xE0m V\u01B0\u1EDDn"
  npcTitle: "N\xF4ng d\xE2n v\u01B0\u1EDDn chu\u1ED1i & d\u1EEBa n\u01B0\u1EDBc"
  openingLines:
  - "M\u1EA5y qu\xE0y d\u1EEBa n\u01B0\u1EDBc b\xEAn kia m\u01B0\u01A1ng ng\u1ECDt n\u01B0\u1EDBc c\u01A1m d\xE0y d\u1EEF l\u1EAFm An \u01A1i."
  - "Chi\u1EC1u nay gh\xE9 ch\xFA ch\u1EB7t cho m\u1ED9t tr\xE1i d\u1EEBa n\u01B0\u1EDBc \u0103n cho m\xE1t d\u1EA1."
  choices:
  - choiceText: "D\u1EA1, d\u1EEBa n\u01B0\u1EDBc ch\u1EA5m \u0111\u01B0\u1EDDng \u0103n ngon h\u1EBFt s\u1EA9y!"
    responseLine: "Hahaha, \u0111\xFAng \u0111i\u1EC7u d\xE2n C\xE0 Mau r\u1ED3i \u0111\xF3 ch\xE1u!"
    responseAnim: Male_Talking_01
  defaultAnimState: Male_Waving
  talkAnimState: Male_Talking_01

  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "Ch\u1ECB T\u01B0 G\xE1nh N\u01B0\u1EDBc"
  npcTitle: "Ng\u01B0\u1EDDi g\xE1nh n\u01B0\u1EDBc gi\u1EBFng ng\u1ECDt x\xF3m"
  openingLines:
  - "Tr\xE1nh \u0111\u01B0\u1EDDng cho ch\u1ECB g\xE1nh \u0111\xF4i th\xF9ng n\u01B0\u1EDBc m\u01B0a ng\u1ECDt v\u1EC1 \u0111\u1ED5 lu nghe An!"
  - "N\u01B0\u1EDBc m\u01B0a m\xF9a n\xE0y trong veo ng\u1ECDt l\u1ECBm, n\u1EA5u tr\xE0 cho c\xE1c c\u1EE5 u\u1ED1ng l\xE0 s\u1ED1 m\u1ED9t."
  choices:
  - choiceText: "\u0110\u1EC3 em ph\u1EE5 ch\u1ECB x\xE1ch m\u1ED9t th\xF9ng nghen!"
    responseLine: "Th\xF4i kh\u1ECFi ch\xFA em nh\u1ECF x\xEDu, x\xE1ch n\u1EB7ng \u0111au l\u01B0ng m\xE1 la ch\u1ECB ch\u1EBFt! Lo \u0111i ch\u01A1i ngoan \u0111i."
    responseAnim: Female_Talking_01
  defaultAnimState: Female_Waving
  talkAnimState: Female_Talking_01
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "C\u1EE5 B\u1EA3y Gi\xE0"
  npcTitle: "L\xE3o th\xE0nh c\xE1ch m\u1EA1ng x\xF3m k\xEAnh"
  openingLines:
  - "C\xE2y tr\xE0m, c\xE2y \u0111\u01B0\u1EDBc C\xE0 Mau b\xE1m r\u1EC5 s\xE2u nh\u01B0 t\u1EA5m l\xF2ng ng\u01B0\u1EDDi d\xE2n Nam B\u1ED9 v\u1EADy ch\xE1u \xE0."
  - "D\xF9 c\xF3 \u0111i \u0111\xE2u xa, ng\u1EEDi m\xF9i r\u01A1m r\u1EA1 l\xFAa ch\xEDn l\xE0 nh\u1EDB da di\u1EBFt qu\xEA nh\xE0."
  choices:
  - choiceText: "Ch\xE1u s\u1EBD lu\xF4n ghi nh\u1EDB l\u1EDDi c\u1EE5 d\u1EA1y \u1EA1."
    responseLine: "Ch\xE1u l\xE0 \u0111\u1EE9a tr\u1EBB ngoan. L\u1EDBn l\xEAn ph\u1EE5 gi\xFAp qu\xEA h\u01B0\u01A1ng \u0111\u1EA5t n\u01B0\u1EDBc nghen ch\xE1u."
    responseAnim: OldMan_Talking
  defaultAnimState: OldMan_Idle
  talkAnimState: OldMan_Talking
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

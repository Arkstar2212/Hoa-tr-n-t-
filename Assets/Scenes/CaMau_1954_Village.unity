MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 330113677}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "Th\u1EB1ng Minh"
  npcTitle: "B\u1EA1n n\u1ED1i kh\u1ED1 c\u1EE7a B\xE9 An"
  openingLines:
  - "\xCA An! \u0110i b\u1EAFt c\xE0o c\xE0o trong ru\u1ED9ng l\xFAa v\xE0ng v\u1EDBi tao kh\xF4ng?"
  - "H\xF4m qua tao th\u1EA5y t\u1ED5 chim s\u1EBB \u0111\u1ED3ng n\xFAp d\u01B0\u1EDBi g\u1ED1c l\xFAa b\u1EF1 ch\xE0 b\xE1 lu\xF4n \xE1!"
  choices:
  - choiceText: "\u0110i li\u1EC1n! Nh\u01B0ng coi ch\u1EEBng d\u1EABm g\xE3y l\xFAa c\u1EE7a b\xE1c N\u0103m nha!"
    responseLine: "Bi\u1EBFt r\u1ED3i, tao \u0111i men theo b\u1EDD m\u1EABu ru\u1ED9ng th\xF4i, kh\xF4ng c\xF3 d\u1EABm b\u1EADy b\u1EA1 \u0111\xE2u m\xE0 s\u1EE3!"
    responseAnim: Waving_02
  - choiceText: "M\xE1 tao \u0111ang g\u1ECDi v\u1EC1 \u0103n c\u01A1m r\u1ED3i, l\xE1t g\u1EB7p nghen!"
    responseLine: "\u1EDC, \u0103n l\u1EB9 r\u1ED3i ch\u1EA1y ra \u0111\u1EA7u c\u1EA7u kh\u1EC9 \u0111\u1EA7u x\xF3m h\xFA tao m\u1ED9t ti\u1EBFng!"
    responseAnim: Waving_01
  defaultAnimState: Waving_01
  talkAnimState: Waving_02
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

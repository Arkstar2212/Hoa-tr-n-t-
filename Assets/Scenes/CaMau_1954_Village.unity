  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "B\xE9 T\xE8o"
  npcTitle: "Tr\u1EBB x\xF3m trong"
  openingLines:
  - "Anh An \u01A1i! Ch\u1EA1y \u0111ua ra \u0111\u1EA7u ng\xF5 v\u1EDBi em kh\xF4ng?"
  - "Em ch\u1EA1y nhanh nh\u01B0 gi\xF3 tho\u1EA3ng, \u0111\u1ED1 anh b\u1EAFt k\u1ECBp em \u0111\xF3!"
  choices:
  - choiceText: "Ch\u1EA1y \u0111ua th\xEC ch\u1EA1y \u0111ua, anh ch\u1EA5p em ba b\u01B0\u1EDBc lu\xF4n!"
    responseLine: "Hi hi, chu\u1EA9n b\u1ECB nghen anh An: M\u1ED9t... Hai... Ba... Ch\u1EA1y!"
    responseAnim: Waving_01
  - choiceText: "\u0110\u1EC3 l\xE1t n\u1EEFa nghen, anh \u0111ang c\xF3 vi\u1EC7c c\u1EA7n ra b\u1EBFn \u0111\xF2."
    responseLine: "D\u1EA1, l\xE1t n\u1EEFa anh v\u1EC1 nh\u1EDB ch\u1EA1y \u0111ua v\u1EDBi em \u0111\xF3 nha!"
    responseAnim: Waving_02
  defaultAnimState: Waving_01
  talkAnimState: Waving_02
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

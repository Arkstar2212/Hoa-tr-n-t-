MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 748354826}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "Ch\xFA B\u1EA3y Ch\xE8o \u0110\xF2"
  npcTitle: "Ch\u1EE7 xu\u1ED3ng ba l\xE1 - B\u1EBFn S\xF4ng \u0110\u1ED1c"
  openingLines:
  - "Xu\u1ED3ng ba l\xE1 chu\u1EA9n b\u1ECB t\xE1ch b\u1EBFn sang c\u1ED3n d\u1EEBa n\u01B0\u1EDBc r\u1ED3i \u0111\xE2y con \u01A1i!"
  - "Gi\xF3 bi\u1EC3n C\xE0 Mau th\u1ED5i l\u1ED3ng l\u1ED9ng, con n\u01B0\u1EDBc r\xF2ng \u0111\u01B0a ghe thuy\u1EC1n t\u1EA5p n\u1EADp v\u1EC1 c\u1EEDa bi\u1EC3n."
  choices:
  - choiceText: "Ch\xFA B\u1EA3y cho con qu\xE1 giang qua b\xEAn kia s\xF4ng v\u1EDBi!"
    responseLine: "L\xEAn xu\u1ED3ng ng\u1ED3i im nghe con, s\xF4ng s\xE2u n\u01B0\u1EDBc xi\u1EBFt, ch\u1EDB th\xF2 tay qu\u01A1 n\u01B0\u1EDBc k\u1EBBo tr\u01B0\u1EE3t ch\xE2n!"
    responseAnim: Male_Talking_01
  - choiceText: "Ch\xFA \u01A1i, ngo\xE0i bi\u1EC3n S\xF4ng \u0110\u1ED1c t\xE0u t\u1EADp k\u1EBFt to l\u1EAFm h\u1EA3 ch\xFA?"
    responseLine: "To nh\u01B0 qu\u1EA3 n\xFAi con \xE0! T\xE0u ch\u1EDF c\xE1n b\u1ED9 \u0111\u1ED3ng b\xE0o ra B\u1EAFc, c\u1EDD \u0111\u1ECF sao v\xE0ng bay r\u1EF1c r\u1EE1 c\u1EA3 g\xF3c tr\u1EDDi!"
    responseAnim: Male_Talking_02
  defaultAnimState: Male_Waving
  talkAnimState: Male_Talking_01
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}

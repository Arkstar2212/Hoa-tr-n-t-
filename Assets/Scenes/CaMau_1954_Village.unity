--- !u!114 &1683678387
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1683678385}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6196a7cc721556d4782c250da9f74f3c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HoaVaMau.Dialogue.GenshinNPCInteractable
  npcName: "M\xE1 c\u1EE7a An"
  npcTitle: "M\xE1 N\u0103m - X\xF3m B\u1EDD K\xEAnh"
  openingLines:
  - "An \u0111\xF3 h\u1EA3 con? \u0110i ch\u01A1i \u0111\xE2u t\u1EEB s\xE1ng t\u1EDBi gi\u1EDD, l\xFAa ch\xEDn v\xE0ng c\u1EA3 c\xE1nh \u0111\u1ED3ng r\u1ED3i k\xECa."
  - "V\u1EC1 nh\xE0 \u0103n ch\xE9n c\u01A1m g\u1EA1o m\u1EDBi m\xE1 v\u1EEBa n\u1EA5u, d\u1EBBo v\xE0 th\u01A1m l\u1EEBng lu\xF4n n\xE8 con."
  choices:
  - choiceText: "D\u1EA1 m\xE1, c\u01A1m g\u1EA1o m\u1EDBi th\u01A1m qu\xE1 m\xE1 \u01A1i!"
    responseLine: "\u1EEA, \u0103n no r\u1ED3i ph\u1EE5 c\xE1c b\xE1c ngo\xE0i s\xE2n ph\u01A1i l\xFAa nghe con. Nh\u1EDB \u0111\u1EEBng ch\u1EA1y nh\u1EA3y l\xE0m \u0111\u1ED5 nia th\xF3c."
    responseAnim: Female_Talking_01
  - choiceText: "M\xE1 \u01A1i, chi\u1EC1u nay con ra b\u1EBFn xem t\xE0u t\u1EADp k\u1EBFt nghen?"
    responseLine: "\u0110\u01B0\u1EE3c ch\u1EDB, nh\u1EDB r\u1EE7 th\u1EB1ng Minh \u0111i chung cho c\xF3 b\u1EA1n, ch\u1EDB c\xF3 nh\u1EA3y gi\u1EE1n d\u01B0\u1EDBi m\xE9 n\u01B0\u1EDBc s\xE2u nghe ch\u01B0a!"
    responseAnim: Female_Talking_02
  defaultAnimState: Female_Waving
  talkAnimState: Female_Talking_01
  interactRadius: 3
  promptOffset: {x: 0, y: 2.05, z: 0}
  customCamOffset: {x: 0, y: 0, z: 0}
